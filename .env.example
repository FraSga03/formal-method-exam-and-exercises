# Optional. Every feature except the assistant and the report's narrative
# section works with none of this set.

# --- Local model (recommended): no key, no billing, works offline ---
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Then:    ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Hosted, for machines that cannot run a local model ---
# https://platform.openai.com/api-keys  (billed per token)
OPENAI_API_KEY=

# https://aistudio.google.com/apikey  (free tier available)
GEMINI_API_KEY=
# Model names are retired over time; -latest tracks the current one
GEMINI_MODEL=gemini-flash-latest
